# Application Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Clarion"
APP_VERSION="1.0.0"
DEBUG=false

# Paths
DATA_DIR=./data
VECTORSTORE_DIR=./data/vectorstore
LOGS_DIR=./logs

# Database
DATABASE_URL=sqlite:///./data/clarion.db

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_BATCH_SIZE=32
# Options: "auto" (recommended), "cuda", "cpu", "mps"
EMBEDDING_DEVICE=auto

# Chunking (word-based, not tokenizer-based)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# LLM Provider Selection
# Options: "ollama", "openai", "deepseek", "gemini"
LLM_PROVIDER=ollama

# DeepSeek API (set LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Google Gemini API (set LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenAI API (set LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Ollama Configuration (Local Models) - set LLM_PROVIDER=ollama
# Ollama auto-detects GPU - make sure CUDA is installed for GPU acceleration
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_API_BASE=http://localhost:11434/v1

# LLM Settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_CONTEXT_WINDOW=4096
LLM_RESERVED_OUTPUT_TOKENS=2000
LLM_TOKEN_SAFETY_TOKENS=256
# Optional exact tokenizer identifier matching the served model (local cache only).
# LLM_TOKENIZER_NAME=

# Dataset Generation (Autonomous Factory)
DATASET_GENERATION_ENABLED=true
DATASET_QUALITY_THRESHOLD=0.82
DATASET_DEDUP_THRESHOLD=0.85
DATASET_BATCH_SIZE=10
DATASET_EXPORT_FORMAT=jsonl
DATASET_LLM_SAMPLE_RATE=0.3
DATASET_GENERATION_INTERVAL_HOURS=1.0
DATASET_REQUIRE_LLM_FOR_EXPORT=true
DATASET_BACKGROUND_POSTPROCESS_ENABLED=true

# Retrieval
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf", ".docx"]
